{
  "opencollection": "1.0.0",
  "info": {
    "name": "Conekta Antifraud Tokens API",
    "version": "2.2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.conekta.io/tokens",
            "headers": [
              {
                "name": "Accept-Language",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generate a payment token, to associate it with a card, Endpoint could be use directly only for PCI compliance account\n"
        }
      ]
    }
  ],
  "bundled": true
}